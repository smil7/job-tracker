# Backend (backend/.env)
DATABASE_URL=postgresql+asyncpg://jobtracker:jobtracker@localhost:5433/jobtracker
TEST_DATABASE_URL=postgresql+asyncpg://jobtracker:jobtracker@localhost:5433/jobtracker_test
CORS_ORIGINS=["http://localhost:5173"]

OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# Most AI requests (review + cover letter) one user can start each day (UTC). 0 turns the AI off.
AI_DAILY_LIMIT=20

# Login (Cognito). Local development skips login entirely.
# In production set AUTH_DISABLED=false and fill in the COGNITO_* values.
AUTH_DISABLED=true
ENVIRONMENT=development

# Logging. LOG_LEVEL is DEBUG, INFO, WARNING or ERROR. GIT_SHA is shown by /api/health (the deploy sets it).
LOG_LEVEL=INFO
GIT_SHA=dev
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Hosted UI domain, for example myapp.auth.eu-central-1.amazoncognito.com
COGNITO_DOMAIN=
GIT_SHA=dev
