# Production build settings (put them in the deploy workflow, or in frontend/.env.production.local).
# Get the values from the Cognito user pool that Terraform creates.
VITE_COGNITO_REGION=eu-central-1
VITE_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Hosted UI domain, without https://
VITE_COGNITO_DOMAIN=myapp.auth.eu-central-1.amazoncognito.com
